mpi_library Open MPI v4.1.4, package: Debian OpenMPI, ident: 4.1.4, repo rev: v4.1.4, May 26
mpirun -np 2 -x OMP_NUM_THREADS=2 bin/vanda-sim2/hybrid_check
hybrid_check ranks=2 provided=1 funneled=1 min_team=2 PASS
