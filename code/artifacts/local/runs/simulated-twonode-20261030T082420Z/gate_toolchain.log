g++ -O2 -fopenmp -o bin/vanda-sim2/omp_check tests/toolchain/omp_check.cpp
mpicxx -O2 -DOMPI_SKIP_MPICXX -DMPICH_SKIP_MPICXX -o bin/vanda-sim2/mpi_check tests/toolchain/mpi_check.cpp
mpicxx -O2 -fopenmp -DOMPI_SKIP_MPICXX -DMPICH_SKIP_MPICXX -o bin/vanda-sim2/hybrid_check tests/toolchain/hybrid_check.cpp
OMP_NUM_THREADS=4 bin/vanda-sim2/omp_check
