#!/bin/bash
# Two-node correctness job: ranks on two distinct compute hosts, placement
# inside each node's allocation, MPI data exchange between nodes, and hybrid
# results identical to serial with uneven ownership. Not a benchmark.
#
# Submit only through jobs/vanda/submit.sh (explicit queue and allocation).
# place=scatter forces the two chunks onto different nodes.
#
#PBS -N p3_twonode
#PBS -l select=2:ncpus=8:mpiprocs=8:mem=16gb
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -j oe

set -uo pipefail
cd "${PBS_O_WORKDIR:?run under PBS, from the code/ directory}"

JOB=${PBS_JOBID%%.*}
RUN_ID=${RUN_ID:-twonode-$(date -u +%Y%m%dT%H%M%SZ)-$JOB}
OUT=${RUNS_ROOT:-artifacts/cluster/runs}/$RUN_ID
mkdir -p "$OUT/env"
exec > >(tee "$OUT/job.log") 2>&1
echo "run_id=$RUN_ID job=${PBS_JOBID} host=$(hostname) start=$(date -Is) source_rev=${SOURCE_GIT_REV:-unset}"

# ---------------------------------------------------------------- modules
MPI_MODULE=${MPI_MODULE:-OpenMPI/4.1.6-GCC-13.2.0}
PY_MODULE=${PY_MODULE:-Python/3.11.5-GCCcore-13.2.0}
type module >/dev/null 2>&1 || source /etc/profile >/dev/null 2>&1
if type module >/dev/null 2>&1; then
    module purge
    module load "$MPI_MODULE" || { echo "FATAL: cannot load $MPI_MODULE"; exit 3; }
elif [ "${ALLOW_NO_MODULES:-0}" != 1 ]; then
    echo "FATAL: no module command on this node"; exit 3
fi
if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 7))' 2>/dev/null; then
    type module >/dev/null 2>&1 && module load "$PY_MODULE"
fi
python3 -c 'import sys; sys.exit(sys.version_info < (3, 7))' \
    || { echo "FATAL: python3 >= 3.7 not available (tried $PY_MODULE)"; exit 3; }

# ---------------------------------------------------------------- launcher
# PBS-integrated launch is required, not just available. Job 1506687 showed
# that ompi_info lists the tm components even when they cannot be loaded
# (libpbs.so.0 lives in /opt/pbs/lib, off the default library path), and
# that run silently fell back to pbs_tmrsh with a hostfile. Here tm is forced
# for both node discovery (ras) and launch (plm), so mpirun fails rather than
# falling back; the allocation check then confirms from mpirun's own
# component-selection log and the remote process ancestry that tm was used.
# REQUIRE_PBS_TM=0 is for local simulation only (no PBS there).
[ -d /opt/pbs/lib ] && export LD_LIBRARY_PATH=/opt/pbs/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
REQUIRE_PBS_TM=${REQUIRE_PBS_TM:-1}
NODES=$(sort -u "${PBS_NODEFILE:-/dev/null}" | wc -l)
PREFIX=${EBROOTOPENMPI:-$(dirname "$(dirname "$(command -v mpirun)")")}
if [ "$REQUIRE_PBS_TM" = 1 ]; then
    LAUNCH=tm; LAUNCH_FLAGS="--mca plm tm --mca ras tm"
else
    LAUNCH=simulated; LAUNCH_FLAGS="--hostfile $PBS_NODEFILE"
fi
MPI="mpirun --prefix $PREFIX $LAUNCH_FLAGS -x PATH -x LD_LIBRARY_PATH"
echo "nodes=$NODES launcher=$LAUNCH mpirun_base=$MPI"

# ---------------------------------------------------------------- environment record
{
    echo "== date";      date -Is
    echo "== head";      hostname -f
    echo "== launcher";  echo "launch=$LAUNCH nodes=$NODES"; echo "$MPI"
    echo "== pbs";       env | grep -E '^(PBS_|NCPUS|OMP_|SOURCE_GIT_REV)' | sort
    echo "== nodefile";  sort "${PBS_NODEFILE:-/dev/null}" | uniq -c
    echo "== head cpus_allowed"; grep -E 'Cpus_allowed_list|Mems_allowed_list' /proc/self/status
    echo "== head lscpu"; lscpu
    echo "== os";        head -4 /etc/os-release; uname -r
    echo "== modules";   module list 2>&1 || true
    echo "== compilers"; mpicxx --version | head -1
    echo "== mpi";       mpirun --version 2>&1 | head -2
    echo "== ompi_info plm/ras (listing only; the selection log is env/launch_verbose.txt)"
    ompi_info 2>/dev/null | grep -E 'MCA (plm|ras):' || true
    echo "== Open MPI's own build flags (the library, not this project's code)"
    ompi_info 2>/dev/null | grep -o "CXXFLAGS=[^']*" | head -1
    echo "== python";    python3 --version
} > "$OUT/env/environment.txt" 2>&1

# ---------------------------------------------------------------- gates
BIN=bin/vanda-$JOB
# Portable target for this mixed-model correctness job: one binary built on
# the head node runs on both nodes without relying on a comparison of CPU
# flags. Serial and hybrid builds both take CXXFLAGS (see the Makefile).
# Benchmarks use -march=native on a single CPU model instead.
export CXXFLAGS="-O3 -std=c++17 -Wall -Wextra -march=x86-64 -mtune=generic"
: > "$OUT/gates.txt"
gate() {
    local name=$1; shift
    echo; echo "===== gate $name: $*"
    if "$@" > "$OUT/gate_$name.log" 2>&1; then status=PASS; else status=FAIL; fi
    tail -n 30 "$OUT/gate_$name.log"
    echo "$name $status" | tee -a "$OUT/gates.txt"
}

# One unbound process per node reports host, allowed CPUs, architecture,
# model, ISA flags and process ancestry. Required: two distinct hosts, exactly
# the chunk's 8 CPUs on each, x86_64 on each (the portable build target), and,
# under tm, mpirun's log selecting the tm launcher with the remote process
# started by orted and not through sshd. Models and ISA flags are recorded only; mixed
# models are allowed here and make this job unusable as a timing measurement.
allocation_check() {
    $MPI --mca plm_base_verbose 10 --mca ras_base_verbose 10 -np "$NODES" --map-by ppr:1:node \
        --bind-to none bash tests/toolchain/node_report.sh \
        2> "$OUT/env/launch_verbose.txt" | sort | tee "$OUT/env/nodes.txt"
    python3 - "$OUT/env/nodes.txt" "$NODES" "$OUT/env/launch_verbose.txt" "$LAUNCH" "$(hostname -s)" <<'EOF'
import re, sys
nodes, want, verbose, launch, head = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
lines = [l for l in open(nodes) if l.startswith("node ")]
def field(l, k):
    m = re.search(rf"\b{k}=(\S*)", l)
    return m.group(1) if m else ""
def count(spec):
    n = 0
    for part in filter(None, spec.split(",")):
        a, _, b = part.partition("-")
        n += int(b) - int(a) + 1 if b else 1
    return n
hosts = {l.split()[1] for l in lines}
cpus = [count(field(l, "allowed")) for l in lines]
archs = {field(l, "arch") for l in lines}
models = sorted({field(l, "model") for l in lines})
isas = {field(l, "isa") for l in lines}
log = open(verbose, errors="replace").read()
selected = {k: re.findall(rf"\(\s*{k}\) Selected component \[(\w+)\]", log) for k in ("plm", "ras")}
remote = [field(l, "ancestry") for l in lines if l.split()[1] != head]
checks = {
    "two_hosts": len(hosts) == want == 2 and len(lines) == want,
    "cpus_8_each": len(cpus) == want and all(c == 8 for c in cpus),
    "arch_x86_64": archs == {"x86_64"},
}
if launch == "tm":
    checks["plm_tm_selected"] = selected["plm"] == ["tm"]
    checks["remote_orted_not_sshd"] = len(remote) == want - 1 and all(
        "orted" in a.split("<") and "sshd" not in a.split("<") for a in remote)
ok = all(checks.values())
# Supporting evidence only: ras may log no selection line, and /proc may hide
# root's pbs_mom from users (hidepid), which would end the ancestry early.
pbs_mom = [("pbs_mom" in a.split("<")) for a in remote]
print(f"allocation hosts={sorted(hosts)} head={head} allowed_cpus={cpus} archs={sorted(archs)}")
print(f"launcher={launch} plm_selected={selected['plm']} ras_selected={selected['ras']} "
      f"remote_ancestry={remote} remote_pbs_mom_visible={pbs_mom}")
print(f"recorded_only models={models} mixed_models={len(models) > 1} isa_lists_equal={len(isas) == 1}")
print(" ".join(f"{k}={'ok' if v else 'FAIL'}" for k, v in checks.items()))
print("allocation", "PASS" if ok else "FAIL")
sys.exit(0 if ok else 1)
EOF
}

# The binaries must carry the portable flags, and the compiler must resolve
# them to the generic x86-64 target with no AVX/FMA code generation.
flags_check() {
    {
        echo "CXXFLAGS=$CXXFLAGS"
        echo "== mpicxx -show"; mpicxx -show
        echo "== resolved target"; mpicxx $CXXFLAGS -Q --help=target 2>/dev/null | grep -E '^ +-m(arch|tune)='
        echo "== ISA macros defined by these flags"; mpicxx $CXXFLAGS -dM -E -x c++ /dev/null | grep -E '__(SSE4_2|AVX|AVX2|FMA|AVX512F)__' || echo none
        echo "== embedded in binaries"
        for b in "$BIN/bh_serial" "$BIN/bh_hybrid"; do printf '%s: ' "$b"; grep -a -o -m1 -- '-O3 -std=c++17[^[:cntrl:]]*' "$b" | head -1; done
    } | tee "$OUT/env/build_flags.txt"
    grep -Eq -- '-march=[[:space:]]+x86-64$' "$OUT/env/build_flags.txt" \
        && grep -q '^none$' "$OUT/env/build_flags.txt" \
        && [ "$(grep -c -- '-march=x86-64 -mtune=generic' "$OUT/env/build_flags.txt")" -ge 3 ] \
        && ! grep -q -- '-march=native' "$OUT/env/build_flags.txt"
}

gate allocation   allocation_check
# Fail fast: without two distinct hosts, the expected 8 CPUs per node and a
# verified PBS launch, nothing after this point would mean what it claims. The failed
# check's output stays in gate_allocation.log, env/nodes.txt and gates.txt.
if grep -q "^allocation FAIL" "$OUT/gates.txt"; then
    echo; echo "STOP: allocation check failed; not compiling or running further gates"
    cat "$OUT/gate_allocation.log"
    echo "end=$(date -Is)"
    exit 5
fi
gate build        make BIN="$BIN" all hybrid
gate flags        flags_check
gate toolchain    make BIN="$BIN" toolchain
gate internode_2  make BIN="$BIN" MPIRUN="$MPI" internode INTERNODE_NP=2 INTERNODE_HOSTS=2
gate internode_16 make BIN="$BIN" MPIRUN="$MPI" internode INTERNODE_NP=16 INTERNODE_HOSTS=2
gate place_1x8    make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=1 PLACE_T=8
gate place_2x4    make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=2 PLACE_T=4
gate place_4x2    make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=4 PLACE_T=2
gate place_8x1    make BIN="$BIN" MPIRUN="$MPI" placement PLACE_NODES=2 PLACE_R=8 PLACE_T=1
gate serial       make BIN="$BIN" EVIDENCE="$OUT" check
# Round-robin mapping spreads every multi-rank case over both nodes; the gate
# requires each such run to report two hosts.
gate hybrid       make BIN="$BIN" EVIDENCE="$OUT" check-hybrid MPIRUN=mpirun \
                      MPIRUN_FLAGS="${MPI#mpirun } -x OMP_NUM_THREADS --map-by node --bind-to none" \
                      HYBRID_GATE_ARGS="--max-cores 16 --suite multinode --expect-hosts 2"
gate recorder env OMP_NUM_THREADS=4 OMP_PROC_BIND=close OMP_PLACES=cores \
    python3 scripts/run_case.py --out "$OUT" --case smoke_bound_2node_4x4 --rep 1 --allocated-cores 16 \
    --launcher "$MPI -np 4 --map-by ppr:2:node:PE=4 --bind-to core -x OMP_NUM_THREADS -x OMP_PROC_BIND -x OMP_PLACES" \
    -- "$BIN/bh_hybrid" --n 50000 --steps 2 --schedule dynamic --chunk 64

echo; echo "===== summary"; cat "$OUT/gates.txt"
echo "end=$(date -Is)"
! grep -q FAIL "$OUT/gates.txt"
